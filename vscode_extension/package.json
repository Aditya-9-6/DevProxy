{
  "name": "devproxy-extension",
  "displayName": "DevProxy Agent Panel",
  "description": "VS Code extension for real‑time DevProxy monitoring and 1‑Click replay/patch.",
  "version": "0.0.1",
  "publisher": "adity",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:devproxy.openPanel"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [{
      "command": "devproxy.openPanel",
      "title": "Open DevProxy Agent Panel"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint . --ext .ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0",
    "eslint": "^8.57.0",
    "@types/node": "^20.12.0"
  }
}
