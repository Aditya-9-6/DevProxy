FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY . .
RUN go build -o /app/bin/saas ./cmd/saas

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
RUN addgroup -S gossipmesh && adduser -S gossipmesh -G gossipmesh
USER gossipmesh
COPY --from=builder /app/bin/saas /usr/local/bin/saas
ENTRYPOINT ["/usr/local/bin/saas"]
