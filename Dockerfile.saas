FROM python:3.12-slim

# Set workdir
WORKDIR /app

# Copy requirements (if any) and install uv
COPY requirements.txt .
RUN pip install --no-cache-dir uv && uv pip install -r requirements.txt

# Copy source code
COPY . .

# Expose port
EXPOSE 8002

# Run FastAPI
CMD ["uvicorn", "devproxy_agent.saas.control_plane:app", "--host", "0.0.0.0", "--port", "8002"]
